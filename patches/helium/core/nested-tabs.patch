+
+void RootTabCollectionNode::ScheduleActiveNestedTabReveal(
+    tabs::TabHandle tab_handle) {
+  if (orientation() != TabStripOrientation::kVertical ||
+      tab_strip_model_->closing_all()) {
+    return;
+  }
+  const bool already_scheduled = pending_active_nested_tab_reveal_.has_value();
+  pending_active_nested_tab_reveal_ = tab_handle;
+  if (already_scheduled) {
+    return;
+  }
+  // Both collection and selection callbacks run under the mutation guard.
+  // Coalesce a transaction's moves and do not run inside a nested event loop.
+  // Visuals-only collapse/expand notifications deliberately do not schedule us.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE,
+      base::BindOnce(&RootTabCollectionNode::RevealPendingActiveNestedTab,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
