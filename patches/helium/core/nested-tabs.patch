+void RootTabCollectionNode::ScheduleActiveNestedTabRevealForNode(
+    const TabCollectionNode* node) {
+  // Collection notifications precede selection-index cache invalidation. Use
+  // the active identity, not active_index(), while the transaction is replayed.
+  auto* active_tab = tab_strip_model_->selection_model().active_tab();
+  if (node && active_tab && node->GetNodeForHandle(active_tab->GetHandle())) {
+    ScheduleActiveNestedTabReveal(active_tab->GetHandle());
+  }
