+
+void BrowserWebContentsDelegate::MaybeNestNewTab(
+    content::WebContents* source,
+    content::WebContents* new_contents,
+    WindowOpenDisposition disposition) {
+  if (!source || !new_contents || source == new_contents ||
+      browser_->IsDeleteScheduled() ||
+      (disposition != WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+       disposition != WindowOpenDisposition::NEW_BACKGROUND_TAB)) {
+    return;
+  }
+
+  const auto* vertical_tabs =
+      tabs::VerticalTabStripStateController::From(&*browser_);
+  // Includes both the vertical-layout state and kHeliumVerticalNesting pref.
+  if (!vertical_tabs || !vertical_tabs->IsTabStripNestingEnabled()) {
+    return;
+  }
+
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (model->closing_all()) {
+    return;
+  }
+  // Resolve by membership rather than dereferencing contents: navigation can
+  // redirect into another window, and its callback may remove either tab.
+  const int source_index = model->GetIndexOfWebContents(source);
+  const int new_index = model->GetIndexOfWebContents(new_contents);
+  if (source_index == TabStripModel::kNoTab ||
+      new_index == TabStripModel::kNoTab ||
+      model->GetTabAtIndex(new_index)->IsSplit() ||
+      !model->AllCanNestInto({new_index}, source_index)) {
+    return;
+  }
+
+  // Navigate/AddWebContents have completed their insertion transactions.
+  model->Nest(source_index, {new_index});
 }
 
