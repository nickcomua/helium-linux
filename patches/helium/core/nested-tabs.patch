+size_t TabStripModel::CountEffectiveMovedTabsLeftOfDestination(
+    const std::vector<int>& indices,
+    int destination_index,
+    const tabs::TabCollection::TypeEnumSet& retain) const {
+  absl::flat_hash_set<int> indices_set(indices.begin(), indices.end());
+  size_t num_effective_moved_to_left_of_destination = 0;
+
+  for (int i : indices) {
+    if (i >= destination_index) {
+      break;
+    }
+
+    tabs::TabInterface* tab = GetTabAtIndex(i);
+
+    // If this tab is inside a NESTED whose owner is also in `indices` and
+    // NESTED retain is on, it'll be moved via the NESTED, not as an individual
+    // tab. Don't count it here. Note: an owner tab IS structurally inside its
+    // own NESTED, but it isn't "covered" by that NESTED, it's the seed. Only
+    // count coverage by some OTHER NESTED's owner.
+    if (retain.Has(tabs::TabCollection::Type::NESTED)) {
+      bool covered_by_owner = false;
+      for (const tabs::TabCollection* c = tab->GetParentCollection(); c;
+           c = c->GetParentCollection()) {
+        if (c->type() != tabs::TabCollection::Type::NESTED) {
+          continue;
+        }
+        auto* nested = static_cast<const tabs::NestedTabCollection*>(c);
+        tabs::TabInterface* nested_owner = nested->data()->owner_tab().Get();
+        if (nested_owner == tab) {
+          // `tab` owns this NESTED. Skip past, look for an outer one.
+          continue;
+        }
+        const int owner_idx = GetIndexOfTab(nested_owner);
+        if (indices_set.contains(owner_idx)) {
+          covered_by_owner = true;
+          break;
+        }
+      }
+      if (covered_by_owner) {
+        continue;
+      }
+    }
+
+    num_effective_moved_to_left_of_destination++;
+
+    // If this tab owns a NESTED and NESTED retain is on, the NESTED's children
+    // are part of the move set even though they're not in `indices`. The owner
+    // itself is already counted above, so only add the non-owner descendants.
+    if (retain.Has(tabs::TabCollection::Type::NESTED)) {
+      if (auto* nested = contents_data_->GetNestedTabCollection(tab)) {
+        num_effective_moved_to_left_of_destination +=
+            nested->TabCountRecursive() - 1;
+      }
+    }
+  }
+  return num_effective_moved_to_left_of_destination;
