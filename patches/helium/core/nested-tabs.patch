+
+NestedTabView::NestedTabView(TabCollectionNode* node)
+    : DraggedTabsContainer(*this, node,
+          node->orientation() == TabStripOrientation::kVertical
+              ? DragAxes::kVerticalOnly : DragAxes::kHorizontalOnly,
+          node->orientation() == TabStripOrientation::kVertical
+              ? DragLayout::kVertical : DragLayout::kHorizontal),
+      vertical_(node->orientation() == TabStripOrientation::kVertical),
+      collection_node_(node),
+      layout_manager_(*SetLayoutManager(
+          std::make_unique<TabCollectionAnimatingLayoutManager>(
+              std::make_unique<views::DelegatingLayoutManager>(this), *this,
+              vertical_ ? TabCollectionAnimatingLayoutManager::AnimationAxis::kVertical
+                        : TabCollectionAnimatingLayoutManager::AnimationAxis::kHorizontal,
+              // The parent already animates the wrapper's bounds. Publishing
+              // an interpolated preferred size here retargets that animation
+              // every frame, cascading settling delays through deeper nests.
+              /*animate_host_size=*/false))) {
+  node->set_remove_child_from_node(base::BindRepeating(
+      &TabCollectionAnimatingLayoutManager::AnimateAndDestroyChildView,
+      base::Unretained(&layout_manager_.get())));
+  node->set_attach_child_to_node(base::BindRepeating(
+      &NestedTabView::AttachChildView, base::Unretained(this)));
+  node->set_detach_child_from_node(base::BindRepeating(
+      [](NestedTabView* self, views::View* child) {
+        return self->RemoveChildViewT(child);
+      }, base::Unretained(this)));
+  node_destroyed_subscription_ = node->RegisterWillDestroyCallback(
+      base::BindOnce(&NestedTabView::ResetCollectionNode, base::Unretained(this)));
+  data_changed_subscription_ = node->RegisterTabSelectionChangedCallback(
+      base::BindRepeating(&NestedTabView::OnDataChanged, base::Unretained(this)));
+}
+NestedTabView::~NestedTabView() = default;
+
+gfx::Rect NestedTabView::GetOwnerRowBoundsForDrag() const {
+  if (!collection_node_ || collection_node_->children().empty()) {
+    return {};
+  }
+  const auto* owner_view = collection_node_->children().front()->view();
+  const auto* layout = GetLayoutForDrag().GetLayoutFor(owner_view);
+  return layout && layout->visible ? layout->bounds : gfx::Rect();
+}
+
+bool NestedTabView::CanDragIntoContents(
+    const gfx::Point& point_in_screen) const {
+  if (!collection_node_ || IsCollapsed()) {
+    return false;
+  }
+  if (!vertical_) {
+    return true;
+  }
+  const auto owner_bounds = GetOwnerRowBoundsForDrag();
+  const auto point = views::View::ConvertPointFromScreen(this, point_in_screen);
+  return !owner_bounds.IsEmpty() && point.y() >= owner_bounds.bottom();
+}
+
+bool NestedTabView::IsCollapsed() const {
+  if (!vertical_ || !collection_node_) {
+    return false;
+  }
+  const auto* nested = static_cast<const tabs::NestedTabCollection*>(
+      std::get<tabs::ConstDanglingUntriagedTabCollection>(
+          collection_node_->GetNodeData()));
+  return nested->data()->visual_data()->IsCollapsed();
+}
+
+views::ProposedLayout NestedTabView::CalculateProposedLayout(
+    const views::SizeBounds& size_bounds) const {
+  views::ProposedLayout layout;
+  if (!collection_node_) {
+    return layout;
+  }
+  const auto children = collection_node_->GetDirectChildren();
+  if (!vertical_) {
+    const int height = TabStyle::Get()->GetStandardHeight();
+    const auto info = CollectVisibleChildLayoutInfo(
+        children, height, base::BindRepeating([](const views::View*) {
+          return true;
+        }));
+    const int preferred = info.total_preferred_width - info.overlap_total;
+    const int minimum = info.total_min_width - info.overlap_total;
+    const int width = std::clamp(size_bounds.width().value_or(preferred),
+                                 minimum, preferred);
+    const auto widths = CalculateProportionalChildWidths(
+        width + info.overlap_total, info.preferred_widths,
+        info.crossover_widths, info.min_widths, info.total_preferred_width,
+        info.total_crossover_width, info.total_min_width);
+    int x = 0;
+    for (size_t i = 0; i < children.size(); ++i) {
+      const auto drag = GetVisualDataForDraggedView(*children[i]);
+      layout.child_layouts.emplace_back(
+          children[i], true,
+          gfx::Rect(drag ? drag->offset.x() : x, 0, widths[i], height));
+      x += widths[i];
+      if (i + 1 < children.size()) {
+        x -= GetChildOverlap(children[i], children[i + 1]);
+      }
+    }
+    layout.host_size = gfx::Size(width, height);
+    return layout;
+  }
+  const bool collapsed = IsCollapsed();
+  int main = 0;
+  int cross = 0;
+  for (size_t i = 0; i < children.size(); ++i) {
+    auto* child = children[i];
+    const bool visible = !collapsed || i == 0;
+    const int indent = vertical_ && i != 0 &&
+        GetTabStripCollapseState() == tabs::VerticalTabStripCollapseState::kExpanded
+        ? kNestedIndent : 0;
+    views::SizeBounds available(size_bounds.width(), {});
+    if (vertical_ && size_bounds.width().is_bounded()) {
+      available.set_width(std::max(0, size_bounds.width().value() - indent));
+    }
+    gfx::Size preferred = child->GetPreferredSize(available);
+    gfx::Rect bounds;
+    if (vertical_) {
+      bounds = gfx::Rect(indent, main,
+          size_bounds.width().is_bounded() ? available.width().value()
+                                          : preferred.width(),
+          visible ? preferred.height() : 0);
+      if (visible) {
+        main += preferred.height() + 2;
+        cross = std::max(cross, bounds.right());
+      }
+    } else {
+      bounds = gfx::Rect(main, 0, preferred.width(), preferred.height());
+      main += preferred.width();
+      cross = std::max(cross, preferred.height());
+    }
+    if (auto drag = GetVisualDataForDraggedView(*child)) {
+      bounds.set_y(drag->offset.y());
+    }
+    // Visibility belongs to the layout, not an animation-completion callback:
+    // restored collapsed subtrees and children inserted while collapsed must
+    // never become focusable or steal drag hit tests.
+    layout.child_layouts.emplace_back(child, visible, bounds);
+  }
+  if (vertical_ && main) {
+    main -= 2;
+  }
+  layout.host_size = vertical_ ? gfx::Size(cross, main) : gfx::Size(main, cross);
+  return layout;
+}
+
+gfx::Size NestedTabView::GetMinimumSize() const {
+  if (!collection_node_) {
+    return {};
+  }
+  if (vertical_) {
+    return CalculateProposedLayout(views::SizeBounds()).host_size;
+  }
+  const auto info = CollectVisibleChildLayoutInfo(
+      collection_node_->GetDirectChildren(), TabStyle::Get()->GetStandardHeight(),
+      base::BindRepeating([](const views::View*) { return true; }));
+  return gfx::Size(info.total_min_width - info.overlap_total,
+                   TabStyle::Get()->GetStandardHeight());
+}
+
+int NestedTabView::GetCrossoverWidth() const {
+  if (!collection_node_) {
+    return 0;
+  }
+  const auto info = CollectVisibleChildLayoutInfo(
+      collection_node_->GetDirectChildren(), TabStyle::Get()->GetStandardHeight(),
+      base::BindRepeating([](const views::View*) { return true; }));
+  return info.total_crossover_width - info.overlap_total;
+}
+
+std::optional<BrowserRootView::DropIndex> NestedTabView::GetLinkDropIndex(
+    const gfx::Point& point) {
+  if (!collection_node_) {
+    return std::nullopt;
+  }
+  for (const auto& node : collection_node_->children()) {
+    views::View* child = node->view();
+    if (!child || !child->GetVisible()) {
+      continue;
+    }
+    const auto bounds = GetMirroredRect(child->bounds());
+    if (vertical_ ? point.y() >= bounds.bottom() : point.x() >= bounds.right()) {
+      continue;
+    }
+    const auto local = views::View::ConvertPointToTarget(this, child, point);
+    if (auto* nested = views::AsViewClass<NestedTabView>(child)) {
+      return nested->GetLinkDropIndex(local);
+    }
+    const int coord = vertical_ ? local.y() : local.x();
+    const int size = vertical_ ? child->height() : child->width();
+    std::optional<DragPositionHint> hint;
+    if (coord < size * 0.2) {
+      hint = DragPositionHint::kBefore;
+    } else if (coord > size * 0.8) {
+      hint = DragPositionHint::kAfter;
+    } else if (auto* split = views::AsViewClass<SplitTabView>(child)) {
+      return split->GetLinkDropIndex(local);
+    }
+    return GetDragHandler().GetLinkDropIndexForNode(*node, hint);
+  }
+  return GetDragHandler().GetLinkDropIndexForNode(
+      *collection_node_, DragPositionHint::kAfter);
+}
+
+bool NestedTabView::IsDragging() const {
+  return collection_node_ && collection_node_->GetController() &&
+         GetDragHandler().IsDragging();
+}
+bool NestedTabView::IsViewDragging(const views::View& view) const {
+  return collection_node_ && collection_node_->GetController() &&
+         GetDragHandler().IsViewDragging(view);
+}
+bool NestedTabView::ShouldSnapToTarget(const views::View& view) const {
+  return views::IsViewClass<SplitTabView>(&view) ||
+         views::IsViewClass<NestedTabView>(&view);
+}
+bool NestedTabView::ShouldAnimateOpacityForAddAndRemove(
+    const views::View& view) const {
+  return vertical_ && views::IsViewClass<TabView>(&view);
+}
+views::ScrollView* NestedTabView::GetScrollViewForContainer() const {
+  for (views::View* ancestor = const_cast<NestedTabView*>(this); ancestor;
+       ancestor = ancestor->parent()) {
+    if (auto* scroll = views::ScrollView::GetScrollViewForContents(ancestor)) {
+      return scroll;
+    }
+  }
+  return nullptr;
+}
+void NestedTabView::UpdateTargetLayoutForDrag(
+    const std::vector<const views::View*>& views_to_snap) {
+  layout_manager_->ResetViewsToTargetLayout(views_to_snap);
+}
+const views::ProposedLayout& NestedTabView::GetLayoutForDrag() const {
+  return layout_manager_->target_layout();
+}
+const TabCollectionNode* NestedTabView::GetCollectionNodeFromView(
+    const views::View& view) const {
+  if (auto* tab = views::AsViewClass<TabView>(&view)) {
+    return tab->collection_node();
+  }
+  if (auto* split = views::AsViewClass<SplitTabView>(&view)) {
+    return split->collection_node();
+  }
+  if (auto* nested = views::AsViewClass<NestedTabView>(&view)) {
+    return nested->collection_node();
+  }
+  return nullptr;
+}
+void NestedTabView::AttachChildView(std::unique_ptr<views::View> view,
+                                    const gfx::Rect& previous_bounds_in_screen) {
+  layout_manager_->AnimateAndReparentView(std::move(view), previous_bounds_in_screen);
+}
+void NestedTabView::ResetCollectionNode() {
+  collection_node_ = nullptr;
+}
+void NestedTabView::OnDataChanged() {
+  InvalidateLayout();
+}
+BEGIN_METADATA(NestedTabView)
+END_METADATA
