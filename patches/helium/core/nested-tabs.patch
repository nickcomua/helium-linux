+  explicit NestedTabView(TabCollectionNode* node);
+  ~NestedTabView() override;
+  const TabCollectionNode* collection_node() const { return collection_node_; }
+  // Owner-row drops are resolved by the parent as before/inside/after.
+  // Only the visible body of an expanded subtree is a reorder container.
+  bool CanDragIntoContents(const gfx::Point& point_in_screen) const;
+  gfx::Rect GetOwnerRowBoundsForDrag() const;
+  gfx::Size GetMinimumSize() const override;
+  int GetCrossoverWidth() const;
+  std::optional<BrowserRootView::DropIndex> GetLinkDropIndex(
+      const gfx::Point& point);
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds& size_bounds) const override;
+ private:
+  bool IsDragging() const override;
+  bool IsViewDragging(const views::View& view) const override;
+  bool ShouldSnapToTarget(const views::View& view) const override;
+  bool ShouldAnimateOpacityForAddAndRemove(const views::View& view) const override;
+  views::ScrollView* GetScrollViewForContainer() const override;
+  void UpdateTargetLayoutForDrag(
+      const std::vector<const views::View*>& views_to_snap) override;
+  const views::ProposedLayout& GetLayoutForDrag() const override;
+  const TabCollectionNode* GetCollectionNodeFromView(
+      const views::View& view) const override;
+  void AttachChildView(std::unique_ptr<views::View> view,
+                       const gfx::Rect& previous_bounds_in_screen);
+  void ResetCollectionNode();
+  void OnDataChanged();
+  bool IsCollapsed() const;
+  bool vertical_;
+  raw_ptr<TabCollectionNode> collection_node_;
+  raw_ref<TabCollectionAnimatingLayoutManager> layout_manager_;
+  base::CallbackListSubscription node_destroyed_subscription_;
+  base::CallbackListSubscription data_changed_subscription_;
+};
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_NESTED_TAB_VIEW_H_
