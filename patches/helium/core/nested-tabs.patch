+void RootTabCollectionNode::RevealActiveNestedTab(tabs::TabHandle tab_handle) {
+  auto* tab = tab_handle.Get();
+  if (!tab || tab_strip_model_->closing_all() ||
+      orientation() != TabStripOrientation::kVertical ||
+      tab_strip_model_->active_index() == TabStripModel::kNoTab ||
+      tab_strip_model_->GetTabAtIndex(tab_strip_model_->active_index()) != tab) {
+    return;
+  }
+  int index = tab_strip_model_->GetIndexOfTab(tab);
+  auto enclosing = tab_strip_model_->GetEnclosingNestedId(index);
+  while (enclosing) {
+    const auto* data = tab_strip_model_->GetNestingData(*enclosing);
+    if (!data || !data->owner_tab().Get()) {
+      break;
+    }
+    const int owner_index =
+        tab_strip_model_->GetIndexOfTab(data->owner_tab().Get());
+    const auto parent = tab_strip_model_->GetEnclosingNestedId(owner_index);
+    if (tab_strip_model_->IsSubtreeCollapsed(*enclosing)) {
+      tab_strip_model_->SetSubtreeCollapsed(*enclosing, false);
+    }
+    enclosing = parent;
+  }
+}
