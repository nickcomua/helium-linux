+  tabstrip()->MoveNestedTo(*inner, 3, std::nullopt, std::nullopt);
+  tabstrip()->SetSubtreeCollapsed(*inner, false);
+  class ClearCallerSnapshot : public TabStripModelObserver {
+   public:
