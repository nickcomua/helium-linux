+  const auto outer_id = nested_tabs::NestedTabId::GenerateNew();
+  auto outer = std::make_unique<tabs::NestedTabCollection>(
+      outer_id, nested_tabs::NestedTabVisualData(), owner->GetHandle());
+  AppendTab(outer.get(), std::move(owner));
+
+  auto inner_owner = std::make_unique<tabs::TabModel>(MakeWebContents(),
+                                                     GetTabStripModel());
+  const auto inner_id = nested_tabs::NestedTabId::GenerateNew();
+  auto inner = std::make_unique<tabs::NestedTabCollection>(
+      inner_id, nested_tabs::NestedTabVisualData(), inner_owner->GetHandle());
+  AppendTab(inner.get(), std::move(inner_owner));
+  const auto split_id = split_tabs::SplitTabId::GenerateNew();
+  auto split = std::make_unique<tabs::SplitTabCollection>(
+      split_id, split_tabs::SplitTabVisualData());
+  for (int i = 0; i < 2; ++i) {
+    AppendTab(split.get(), std::make_unique<tabs::TabModel>(
+                              MakeWebContents(), GetTabStripModel()));
+  }
+  inner->AddCollection(std::move(split), 1);
+  outer->AddCollection(std::move(inner), 1);
+  auto* outer_ptr = outer.get();
+  strip.InsertTabCollectionAt(std::move(outer), 0, false, std::nullopt);
+  EXPECT_NE(strip.GetNestedTabCollection(outer_id), nullptr);
+  EXPECT_NE(strip.GetNestedTabCollection(inner_id), nullptr);
+  EXPECT_NE(strip.GetSplitTabCollection(split_id), nullptr);
+  strip.ValidateData();
+
+  auto detached = strip.RemoveTabCollection(outer_ptr);
+  EXPECT_EQ(strip.GetNestedTabCollection(outer_id), nullptr);
+  EXPECT_EQ(strip.GetNestedTabCollection(inner_id), nullptr);
+  EXPECT_EQ(strip.GetSplitTabCollection(split_id), nullptr);
+  EXPECT_TRUE(strip.ListNesteds().empty());
+  strip.InsertTabCollectionAt(std::move(detached), 0, false, std::nullopt);
+  EXPECT_NE(strip.GetNestedTabCollection(inner_id), nullptr);
+  EXPECT_NE(strip.GetSplitTabCollection(split_id), nullptr);
+  strip.ValidateData();
+}
+
+TEST_F(TabCollectionBaseTest, SplittingNestedOwnerUnwrapsItsCollection) {
+  auto* model = GetTabStripModel();
+  model->AppendWebContents(MakeWebContents(), true);
+  model->AppendWebContents(MakeWebContents(), false);
+  model->AppendWebContents(MakeWebContents(), false);
+  ASSERT_TRUE(model->Nest(0, {1, 2}).has_value());
+  const auto split_id = split_tabs::SplitTabId::GenerateNew();
+  model->RestoreSplit(split_id, {0, 1}, split_tabs::SplitTabVisualData());
+  EXPECT_TRUE(model->ListNesteds().empty());
+  EXPECT_EQ(model->GetTabAtIndex(0)->GetSplit(), split_id);
+  EXPECT_EQ(model->GetTabAtIndex(1)->GetSplit(), split_id);
+  EXPECT_EQ(model->count(), 3);
+  model->CloseAllTabs();
+}
+
+TEST_F(TabCollectionBaseTest, NestWithNoParentPromotesChild) {
+  auto* model = GetTabStripModel();
+  model->AppendWebContents(MakeWebContents(), true);
+  model->AppendWebContents(MakeWebContents(), false);
+  ASSERT_TRUE(model->Nest(0, {1}).has_value());
+  EXPECT_FALSE(model->Nest(std::nullopt, {1}).has_value());
+  EXPECT_TRUE(model->ListNesteds().empty());
+  EXPECT_EQ(model->count(), 2);
+  model->CloseAllTabs();
+}
