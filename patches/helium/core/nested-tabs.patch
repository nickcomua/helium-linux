+TEST_F(TabStripModelTest, MoveNestedUsesRemainingTreeDestination) {
+  for (bool collapsed : {false, true}) {
+    for (int destination : {2, 3}) {
+      SCOPED_TRACE(testing::Message() << collapsed << ":" << destination);
+      TestTabStripModelDelegate delegate;
+      TabStripModel model(&delegate, profile());
+      std::vector<tabs::TabInterface*> original;
+      for (int i = 0; i < 7; ++i) {
+        model.AppendWebContents(CreateWebContents(), i == 0);
+        original.push_back(model.GetTabAtIndex(i));
+      }
+      // A(B(C),D), E(G), I. Both legal downward destinations are numerically
+      // inside A's OLD interval [0,4), but outside A in the remaining tree.
+      const auto outer = model.Nest(0, {1, 2, 3});
+      const auto inner = model.Nest(1, {2});
+      const auto other = model.Nest(4, {5});
+      ASSERT_TRUE(outer);
+      ASSERT_TRUE(inner);
+      ASSERT_TRUE(other);
+      model.SetSubtreeCollapsed(*inner, true);
+      model.SetSubtreeCollapsed(*outer, collapsed);
+      auto* active = model.GetActiveWebContents();
+      model.MoveNestedTo(*outer, destination);
+      const std::vector<int> expected = destination == 2
+          ? std::vector<int>{4, 5, 0, 1, 2, 3, 6}
+          : std::vector<int>{4, 5, 6, 0, 1, 2, 3};
+      ASSERT_EQ(7, model.count());
+      for (int i = 0; i < model.count(); ++i) {
+        EXPECT_EQ(original[expected[i]], model.GetTabAtIndex(i));
+      }
+      const std::vector<int> parents{-1, 0, 1, 0, -1, 4, -1};
+      for (int i = 0; i < model.count(); ++i) {
+        const auto parent = model.GetParentIndex(model.GetIndexOfTab(original[i]));
+        if (parents[i] == -1) {
+          EXPECT_FALSE(parent);
+        } else {
+          ASSERT_TRUE(parent);
+          EXPECT_EQ(original[parents[i]], model.GetTabAtIndex(*parent));
+        }
+      }
+      EXPECT_EQ(active, model.GetActiveWebContents());
+      EXPECT_EQ(collapsed, model.IsSubtreeCollapsed(*outer));
+      EXPECT_TRUE(model.IsSubtreeCollapsed(*inner));
+      EXPECT_TRUE(model.GetNestingData(*other));
+
+      // Round trip also covers upward placement before an owner.
+      model.MoveNestedTo(*outer, 0);
+      for (int i = 0; i < model.count(); ++i) {
+        EXPECT_EQ(original[i], model.GetTabAtIndex(i));
+      }
+    }
+  }
+}
