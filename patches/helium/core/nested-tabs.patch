+
+#ifndef COMPONENTS_TABS_PUBLIC_NESTED_TAB_DATA_H_
+#define COMPONENTS_TABS_PUBLIC_NESTED_TAB_DATA_H_
+
+#include <vector>
+
+#include "components/nested_tabs/nested_tab_id.h"
