+void SessionService::SetTabNested(
+    SessionID window_id,
+    SessionID tab_id,
+    std::optional<nested_tabs::NestedTabId> nested_id) {
+  if (!ShouldTrackChangesToWindow(window_id)) {
+    return;
+  }
+
+  // Tabs get unnested as they close. However, if the whole window is closing
+  // tabs should stay in their nested. So, ignore this call in that case.
+  if (pending_window_close_ids_.contains(window_id) ||
+      window_closing_ids_.contains(window_id)) {
+    return;
+  }
+
+  ScheduleCommand(
+      sessions::CreateNestedTabCommand(tab_id, std::move(nested_id)));
+}
+
