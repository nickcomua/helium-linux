+void ReconstructNestedTabs(
+    LiveTabContext* context,
+    const std::vector<std::unique_ptr<tab_restore::Tab>>& entries,
+    const std::map<SessionID, LiveTab*>& restored_tabs) {
+  std::map<SessionID, base::WeakPtr<LiveTab>> by_old_live_id;
+  for (const auto& entry : entries) {
+    auto it = restored_tabs.find(entry->id);
+    if (entry->original_live_id.is_valid() && it != restored_tabs.end() && it->second) {
+      by_old_live_id[entry->original_live_id] = it->second->GetWeakPtr();
+    }
+  }
+  // Flat entries are in owner-first visual order, irrespective of the order
+  // AddRestoredTab was called. Missing parents leave their children flat.
+  for (const auto& entry : entries) {
+    if (!entry->parent_session_id) {
+      continue;
+    }
+    auto parent = by_old_live_id.find(entry->parent_session_id->parent_session_id);
+    auto child = by_old_live_id.find(entry->original_live_id);
+    if (parent != by_old_live_id.end() && parent->second &&
+        child != by_old_live_id.end() && child->second) {
+      context->NestRestoredTab(parent->second->GetSessionID(),
+          child->second->GetSessionID(), entry->parent_session_id->child_index);
+    }
+  }
+  for (const auto& entry : entries) {
+    auto live = by_old_live_id.find(entry->original_live_id);
+    if (entry->nested_visual_data && live != by_old_live_id.end() && live->second) {
+      context->SetNestedVisualData(live->second->GetSessionID(),
+                                   *entry->nested_visual_data);
+    }
+  }
