+void SessionServiceBrowserHelper::OnNestedTabChanged(
+    const NestedTabChange& change) {
+  // AppSessionService has no nested-tab commands. Do not create a regular
+  // session service for an app window or rewrite nesting during window close.
+  if (IsRelevantToAppSessionService(browser_type_) ||
+      tab_strip_model_->closing_all()) {
+    return;
+  }
+
+  switch (change.type) {
+    case NestedTabChange::Type::kVisualsChanged:
+      UpdateNestedTabSessionVisualData(change.nested_id);
+      break;
+    case NestedTabChange::Type::kCreated:
+    case NestedTabChange::Type::kContentsChanged:
+    case NestedTabChange::Type::kDestroyed:
+    case NestedTabChange::Type::kMoved:
+      // Read the final tree, not the event's child list. A reparent notifies the
+      // destination before the source; clearing source children would overwrite
+      // their new membership. Attached subtrees also contain deeper nests, and
+      // unnesting can promote children into a grandparent rather than top level.
+      // SyncHistoryWithTabs also persists the resulting flattened tab order.
+      SyncHistoryWithTabs(0);
+      break;
+  }
+}
+
+void SessionServiceBrowserHelper::SyncNestedTabSessionData() {
+  if (IsRelevantToAppSessionService(browser_type_) ||
+      tab_strip_model_->closing_all()) {
+    return;
+  }
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfileIfExisting(&*profile_);
+  if (!session_service) {
+    return;
+  }
+
+  // Only live members are persisted: removed/closing tabs are handled by
+  // TabClosing, and detached tabs will be associated with their new window on
+  // insertion. Never dereference potentially expired event TabHandles here.
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    const auto* tab = tab_strip_model_->GetTabAtIndex(index);
+    session_service->SetTabNested(
+        session_id_, sessions::SessionTabHelper::IdForTab(tab->GetContents()),
+        tab_strip_model_->GetEnclosingNestedId(index));
+  }
+  for (const auto& nested_id : tab_strip_model_->ListNesteds()) {
+    UpdateNestedTabSessionVisualData(nested_id);
+  }
+}
+
+void SessionServiceBrowserHelper::UpdateNestedTabSessionVisualData(
+    const nested_tabs::NestedTabId& nested_id) {
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfileIfExisting(&*profile_);
+  if (!session_service) {
+    return;
+  }
+  const auto* data = tab_strip_model_->GetNestingData(nested_id);
+  CHECK(data);
+  const auto* owner = data->owner_tab().Get();
+  CHECK(owner);
+  session_service->SetNestedTabData(
+      session_id_, nested_id, data->visual_data(),
+      sessions::SessionTabHelper::IdForTab(owner->GetContents()));
+}
