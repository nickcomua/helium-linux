+namespace {
+
+struct NestedTabsMoveState {
+  TabStripModel::NestedDragRestoreData topology;
+  // The entire original subtree, not just the direct children. This prevents
+  // restoring A -> B when the requested set omitted B's child C.
+  std::vector<::tabs::TabHandle> members;
+};
+
+std::vector<NestedTabsMoveState> CaptureCompleteNestedTabsForMove(
+    const std::vector<::tabs::TabHandle>& requested) {
+  std::vector<NestedTabsMoveState> result;
+  std::set<TabStripModel*> captured_models;
+  for (auto handle : requested) {
+    auto* tab = handle.Get();
+    auto* browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (!browser) {
+      continue;
+    }
+    auto* model = browser->GetTabStripModel();
+    if (!captured_models.insert(model).second) {
+      continue;
+    }
+    // All source models are inspected before the first mutation. No model or
+    // collection pointers survive in the returned snapshot.
+    for (auto& entry : model->CaptureNestedDragState(requested)) {
+      std::vector<int> indices = {model->GetIndexOfTab(entry.owner.Get())};
+      std::vector<::tabs::TabHandle> members;
+      bool complete = true;
+      for (size_t i = 0; i < indices.size(); ++i) {
+        auto member = model->GetTabAtIndex(indices[i])->GetHandle();
+        if (!std::ranges::contains(requested, member)) {
+          complete = false;
+          break;
+        }
+        members.push_back(member);
+        const auto children = model->GetChildIndices(indices[i]);
+        indices.insert(indices.end(), children.begin(), children.end());
+      }
+      if (complete) {
+        result.push_back({std::move(entry), std::move(members)});
+      }
+    }
+  }
+  return result;
+}
+
+void RestoreCompleteNestedTabsAfterMove(
+    const std::vector<NestedTabsMoveState>& snapshots,
+    const std::set<::tabs::TabHandle>& moved) {
+  std::set<::tabs::TabHandle> restored;
+  for (const auto& snapshot : snapshots) {
+    if (restored.contains(snapshot.topology.owner)) {
+      continue;
+    }
+    auto* owner = snapshot.topology.owner.Get();
+    auto* browser = owner ? owner->GetBrowserWindowInterface() : nullptr;
+    if (!browser) {
+      continue;
+    }
+    auto* model = browser->GetTabStripModel();
+    std::vector<TabStripModel::NestedDragRestoreData> state;
+    for (const auto& candidate : snapshots) {
+      if (restored.contains(candidate.topology.owner)) {
+        continue;
+      }
+      auto* candidate_owner = candidate.topology.owner.Get();
+      if (!candidate_owner || candidate_owner->IsSplit() ||
+          !std::ranges::all_of(candidate.members, [&](auto handle) {
+            auto* tab = handle.Get();
+            return moved.contains(handle) && tab && !tab->IsPinned() &&
+                   tab->GetBrowserWindowInterface() == browser &&
+                   model->GetIndexOfTab(tab) != TabStripModel::kNoTab;
+          })) {
+        continue;
+      }
+      state.push_back(candidate.topology);
+      restored.insert(candidate.topology.owner);
+    }
+    if (!state.empty()) {
+      // Preserve the capture's descendant-before-ancestor order. Unwrap all
+      // eligible surviving wrappers first, then rebuild in model transactions.
+      model->PrepareNestedDragRestore(state);
+      model->RestoreNestedDragState(state);
+    }
+  }
+}
+
