+std::unique_ptr<tab_restore::Tab> TabRestoreServiceHelper::NestedDfsHelper(
+    LiveTabContext* context,
+    int parent_index,
+    bool do_suppression_tracking) {
+  std::unique_ptr<Tab> root;
+  std::stack<std::pair<Tab*, int>> pending;
+  pending.push({nullptr, parent_index});
+  const SessionID root_id = context->GetSessionIdAtIndex(parent_index);
+  while (!pending.empty()) {
+    auto [parent, index] = pending.top();
+    pending.pop();
+    if (do_suppression_tracking) {
+      closing_subtrees_[root_id].insert(context->GetSessionIdAtIndex(index));
+    }
+    auto tab = std::make_unique<Tab>();
