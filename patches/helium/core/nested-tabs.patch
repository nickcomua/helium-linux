+void TabStripCollection::UnnestCollection(NestedTabCollection* nested) {
+  TabCollection* parent = nested->GetParentCollection();
+  CHECK(parent);
+  size_t insertion_idx = parent->GetIndexOfCollection(nested).value();
+
+  // Snapshot children before mutating. Iteration order is preserved (owner is
+  // first), so the resulting layout in `parent` is [owner, c1, c2, ...] at
+  // `insertion_idx`.
+  std::vector<std::variant<TabInterface*, TabCollection*>> snapshot;
+  for (const auto& child : nested->GetChildren()) {
+    if (auto* t = std::get_if<ScopedTab>(&child)) {
+      snapshot.emplace_back(t->get());
+    } else {
+      snapshot.emplace_back(
+          std::get<std::unique_ptr<TabCollection>>(child).get());
+    }
+  }
+
+  for (auto& item : snapshot) {
+    TabCollection::Position pos{parent->GetHandle(), insertion_idx};
+    if (auto** t = std::get_if<TabInterface*>(&item)) {
+      // Low-level move (skips the "owner moves with NESTED" semantic; the
+      // NESTED is being torn down here).
+      MoveTabImpl(*t, pos);
+    } else {
+      MoveCollectionImpl(std::get<TabCollection*>(item), pos);
+    }
+    insertion_idx++;
+  }
+
+  removed_nested_collections_.push_back(RemoveTabCollectionImpl(nested));
+}
+
+std::optional<TabStripCollection::NestedDestruction>
+TabStripCollection::MaybeDestroyNestedWithOnlyOwner(
+    NestedTabCollection* nested) {
+  // Destroy when shrunk to only the owner (or fewer, defensively).
+  if (nested->ChildCount() > 1) {
+    return std::nullopt;
+  }
+
+  NestedDestruction destroyed = {nested->data()->id(),
+                                 nested->data()->owner_tab()};
+  TabCollection* nested_parent = nested->GetParentCollection();
+  CHECK(nested_parent);
+  const size_t nested_idx = nested_parent->GetIndexOfCollection(nested).value();
+
+  if (nested->ChildCount() == 1) {
+    // Promote owner to NESTED's slot in the parent.
+    TabInterface* owner = nested->data()->owner_tab().Get();
+    CHECK(owner);
+    CHECK_EQ(owner->GetParentCollection(GetPassKey()), nested);
+    CHECK_EQ(nested->GetIndexOfTab(owner).value(), 0u);
+    TabCollection::Position owner_pos{nested_parent->GetHandle(), nested_idx};
+    MoveTabImpl(owner, owner_pos);
+  }
+
+  removed_nested_collections_.push_back(RemoveTabCollectionImpl(nested));
+  return destroyed;
+}
+
+void TabStripCollection::DestroyRemovedNestedCollections() {
+  removed_nested_collections_.clear();
+}
