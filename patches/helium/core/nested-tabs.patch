+std::optional<sessions::tab_restore::NestedTabChildRestorationInfo>
+BrowserLiveTabContext::GetParentSessionIdAndChildIndexForTab(int index) const {
+  std::optional<int> parent_idx = tab_strip_model_->GetParentIndex(index);
+  if (!parent_idx) {
+    return std::nullopt;
+  }
+  tabs::TabInterface* parent_tab = tab_strip_model_->GetTabAtIndex(*parent_idx);
+  CHECK(parent_tab && parent_tab->GetContents());
+
+  // Position among parent's direct children (NOT recursive).
+  std::vector<int> child_indices =
+      tab_strip_model_->GetChildIndices(*parent_idx);
+  auto it = std::ranges::find(child_indices, index);
+  CHECK(it != child_indices.end());
+  size_t pos = it - child_indices.begin();
+
+  return sessions::tab_restore::NestedTabChildRestorationInfo{
+      sessions::SessionTabHelper::IdForTab(parent_tab->GetContents()), pos};
+}
