+void RootTabCollectionNode::RevealPendingActiveNestedTab() {
+  auto pending = std::exchange(pending_active_nested_tab_reveal_, std::nullopt);
+  if (pending) {
+    RevealActiveNestedTab(*pending);
+  }
+}
