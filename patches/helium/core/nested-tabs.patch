+    // gap as a unit too; positioning merely inside it would keep the preview
+    // position of the newly-created group.
+    MoveGroupTo(*original_group, to_index);
+  } else if (nested) {
+    MoveNestedTo(*nested, to_index, original_group, parent);
+  } else {
+    // All descendants closed. Preserve explicit parent/root semantics even
+    // at an unchanged index; MoveWebContentsAt would infer from neighbors.
+    ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+    static constexpr tabs::TabCollection::TypeEnumSet kRetain = {
+        tabs::TabCollection::Type::SPLIT, tabs::TabCollection::Type::NESTED};
+    MoveTabsWithNotifications(
+        moving, to_index,
+        base::BindOnce(&tabs::TabStripCollection::MoveTabsRecursive,
+                       base::Unretained(contents_data_.get()), moving,
+                       to_index, original_group, parent, false, kRetain));
+  }
+}
+
+void TabStripModel::RestoreNested(
+    const nested_tabs::NestedTabId& nested_id,
+    tabs::TabInterface* owner,
+    const std::vector<tabs::TabInterface*>& children,
+    const nested_tabs::NestedTabVisualData& visual_data) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  int owner_idx = GetIndexOfTab(owner);
+  auto children_idxs =
+      children |
+      std::views::transform([&](auto tab) { return GetIndexOfTab(tab); }) |
+      std::ranges::to<std::vector<int>>();
+  if (ContainsIndex(owner_idx) && !owner->IsPinned() && !owner->IsSplit() &&
+      std::ranges::is_sorted(children_idxs) &&
+      (children.empty() || owner_idx < children_idxs.front())) {
+    std::ignore =
+        NestImpl(owner_idx, children_idxs, visual_data, {}, nested_id);
+  } else {
+      LOG(ERROR) << "Nested precondition failed on restore, falling through";
+  }
+
+  CompleteModelUpdateTransaction();
+}
+
+std::optional<nested_tabs::NestedTabId> TabStripModel::NestImpl(
+    std::optional<int> parent,
+    std::vector<int> children,
+    std::optional<nested_tabs::NestedTabVisualData> visual_data,
+    std::optional<size_t> target_child_idx,
+    std::optional<nested_tabs::NestedTabId> id_override) {
+  if (children.empty()) {
+    return std::nullopt;
+  }
+  tabs::TabInterface* parent_tab = parent ? GetTabAtIndex(*parent) : nullptr;
+  CHECK(!parent || parent_tab) << "Unable to find parent tab at index!";
+  // A missing parent means promote to top level, not a null owner.
+  CHECK(!parent_tab || !parent_tab->IsPinned())
+      << "Pinned tabs cannot own NESTED!";
+  CHECK(!parent_tab || !parent_tab->IsSplit())
+      << "Split tabs cannot own NESTED!";
+  CHECK(!parent || !std::ranges::contains(children, *parent))
+      << "A tab cannot nest beneath itself";
+
+  // Need to filter tabs from the same SPLIT
+  std::set<split_tabs::SplitTabId> seen_splits = {};
+  std::vector<tabs::TabInterface*> children_tabs =
+      children | std::views::transform([&](auto idx) {
+        return this->GetTabAtIndex(idx);
+      }) |
+      std::views::filter([&](auto tab) {
+        if (!tab) {
+          return false;
+        }
+
+        auto split = tab->GetSplit();
+        if (split) {
+          if (seen_splits.contains(*split)) {
+            return false;
+          }
+          seen_splits.insert(*split);
+        }
+
+        return true;
+      }) |
+      std::ranges::to<std::vector>();
+
+  // Check for possible cycles
+  // A cycle is defined as the parent being within any child's tree
+  CHECK(!parent ||
+        !IsDescendantOfAny(*parent, std::set(children.begin(), children.end())))
+      << "Cycle detected while trying to nest tabs.";
+
+  // No cycles detected, proceed with nest.
+
+  // Snapshot per source: id, owner (in case destroyed), and removed tabs.
+  struct SourceSnapshot {
+    nested_tabs::NestedTabId id;
+    tabs::TabHandle owner;
+    std::vector<tabs::TabHandle> removed_children;
+  };
+  base::flat_map<nested_tabs::NestedTabId, SourceSnapshot> sources;
+
+  for (auto* child : children_tabs) {
+    auto* p = child->GetParentCollection();
+    if (p && p->type() == tabs::TabCollection::Type::SPLIT) {
+      p = p->GetParentCollection();
+    }
+    if (p && p->type() == tabs::TabCollection::Type::NESTED) {
+      auto* nested = static_cast<const tabs::NestedTabCollection*>(p);
+      auto& snap = sources
+                       .try_emplace(nested->data()->id(),
+                                    SourceSnapshot{nested->data()->id(),
+                                                   nested->data()->owner_tab(),
+                                                   {}})
+                       .first->second;
+      snap.removed_children.push_back(child->GetHandle());
+    }
+  }
+
+  //  Do the moves.
+  std::optional<nested_tabs::NestedTabId> retval;
+  if (parent_tab) {
+    const auto [parent_nested, did_create] =
+        contents_data_->FindOrCreateNestedFor(parent_tab, visual_data,
+                                              id_override);
+
+    // Remove the destination from the sources map AFTER it's known (now that
+    // parent_nested is in scope), there's no net change for tabs already
+    // there.
+    sources.erase(parent_nested->data()->id());
+
+    // |target_child_idx| is the position among the parent's non-owner
+    // children (matches GetChildIndices() semantics). The owner occupies
+    // the NESTED collection's children[0], so shift by 1 when computing the
+    // collection-level insertion index.
+    size_t offset = 0;
+    for (auto* child : children_tabs) {
+      contents_data_->MoveTabToNested(
+          child, parent_nested->data()->id(),
+          target_child_idx.transform([&](auto i) { return i + offset + 1; }));
+      if (target_child_idx) {
+        offset++;
+      }
+      // ignore the returned NestedDestruction, handled in the dispatch loop
+    }
+
+    auto child_handles =
+        children_tabs |
+        std::views::transform([](auto t) { return t->GetHandle(); }) |
+        std::ranges::to<std::vector>();
+
+    if (did_create) {
+      observers_.Notify(
+          &TabStripModelObserver::OnNestedTabChanged,
+          NestedTabChange(this, parent_nested->data()->id(),
+                          NestedTabChange::CreatedChange(
+                              parent_tab->GetHandle(), std::move(child_handles),
+                              visual_data.value_or({}))));
+    } else {
+      observers_.Notify(&TabStripModelObserver::OnNestedTabChanged,
+                        NestedTabChange(this, parent_nested->data()->id(),
+                                        NestedTabChange::ContentsChange(
+                                            std::move(child_handles), {})));
+    }
+
+    retval = parent_nested->data()->id();
+  } else {
+    for (auto* child : children_tabs) {
+      contents_data_->MoveTabToTopLevel(child);
+    }
+    retval = std::nullopt;
+  }
+
+  // Single dispatch loop for every snapshot source.
+  for (auto& [id, snap] : sources) {
+    if (contents_data_->GetNestedTabCollection(id)) {
+      // Source still alive: contents changed.
+      observers_.Notify(
+          &TabStripModelObserver::OnNestedTabChanged,
+          NestedTabChange(this, id,
+                          NestedTabChange::ContentsChange(
+                              {}, std::move(snap.removed_children))));
+    } else {
+      // Source destroyed during moves.
+      observers_.Notify(
+          &TabStripModelObserver::OnNestedTabChanged,
+          NestedTabChange(this, id,
+                          NestedTabChange::DestroyedChange(
+                              snap.owner, std::move(snap.removed_children))));
+    }
+  }
+
+  return retval;
+}
+
+void TabStripModel::Unnest(const nested_tabs::NestedTabId& nested_id) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+
+  UnnestImpl(nested_id);
+  CompleteModelUpdateTransaction();
+}
+
+void TabStripModel::FlattenAllNesting() {
+  // Unnesting a parent promotes its child collections, so repeat until none
+  // remain. Cap the loop so a corrupt cycle cannot hang the UI thread.
+  for (int guard = count(); !ListNesteds().empty() && guard >= 0; --guard) {
+    Unnest(*ListNesteds().begin());
+  }
+}
+
+void TabStripModel::UnnestImpl(const nested_tabs::NestedTabId& nested_id) {
+  tabs::NestedTabCollection* nested_coll =
+      contents_data_->GetNestedTabCollection(nested_id);
+  CHECK(nested_coll);
+
+  tabs::TabHandle destroyed = nested_coll->data()->owner_tab();
+  std::vector<tabs::TabHandle> orphans;
+  for (const auto& child : nested_coll->GetChildren()) {
+    if (auto* t = std::get_if<tabs::ScopedTab>(&child)) {
+      orphans.push_back((*t)->GetHandle());
+    } else {
+      auto* coll = std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+      if (coll->type() == tabs::TabCollection::Type::SPLIT) {
+        // Tabs inside SPLIT also lose their nesting affiliation under this
+        // NESTED, even though they live one layer deep in the storage tree.
+        for (const auto& split_child : coll->GetChildren()) {
+          if (auto* st = std::get_if<tabs::ScopedTab>(
+                  &split_child)) {
+            orphans.push_back((*st)->GetHandle());
+          }
+        }
+      }
+      // Sub-NESTEDs: their tabs are still nested (just under a sub-owner that's
+      // now in grandparent). They didn't lose their nesting. Skip.
+    }
+  }
+
+  // Promote all children to NESTED's parent at NESTED's slot, then destroy
+  // the NESTED. Preserves child order: owner first (it's children[0]), then
+  // non-owner members in their existing order.
+  contents_data_->UnnestCollection(nested_coll);
+
+  observers_.Notify(&TabStripModelObserver::OnNestedTabChanged,
+                    NestedTabChange(this, nested_id,
+                                    NestedTabChange::DestroyedChange(
+                                        destroyed, std::move(orphans))));
+}
+
+void TabStripModel::TryCompletePendingCascade(content::WebContents* descendant,
+                                              bool cancelled) {
+  // First, walk pending_cascades_ and either cancel cascades (cancelled=true)
+  // or remove this descendant from any cascade that's waiting on it. Collect
+  // the parents of cascades that just emptied, DO NOT call CloseTabs from
+  // inside this loop. CloseTabs synchronously closes the parent, which fires
+  // its own WebContentsDestroyed → re-entrant call into this function →
+  // mutates pending_cascades_ → invalidates our outer iterator.
+  struct CompletedCascade {
+    content::WebContents* parent;
+    uint32_t close_types;
+    SessionID parent_session_id;
+  };
+  std::vector<CompletedCascade> completed;
+
+  for (auto it = pending_cascades_.begin(); it != pending_cascades_.end();) {
+    auto& pending = *it;
+    auto desc_it = pending->descendants.find(descendant);
+    if (desc_it == pending->descendants.end()) {
+      ++it;
+      continue;
+    }
+
+    if (cancelled) {
+      // User cancelled beforeunload for this descendant. Abort the entire
+      // cascade, parent stays alive. PendingCascade destructor releases
+      // all sibling observers automatically.
+      if ((*it)->close_types & TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB) {
+        delegate_->NestedSubtreeCloseStopped((*it)->parent_session_id);
+        // Owner won't destruct (the close was cancelled), so the observer
+        // must be torn down explicitly here.
+        nested_subtree_owner_observers_.erase((*it)->parent);
+      }
+      it = pending_cascades_.erase(it);
+      continue;
+    }
+
+    pending->descendants.erase(desc_it);
+
+    if (pending->descendants.empty()) {
+      completed.push_back({pending->parent.get(), pending->close_types,
+                           pending->parent_session_id});
+      it = pending_cascades_.erase(it);
+      continue;
+    }
+
+    ++it;
+  }
+
+  // Now safe to recurse. Re-entry into TryCompletePendingCascade from any of
+  // these CloseTabs calls will iterate a freshly-stable pending_cascades_.
+  for (auto& c : completed) {
+    if (c.parent) {
+      CloseTabs({c.parent}, c.close_types);
+      // NestedSubtreeClosed cleanup is fired by NestedSubtreeOwnerObserver
+      // when the owner's WebContents actually destructs. Firing it here
+      // would clear the suppression set before the owner's
+      // CreateHistoricalTab runs (the close may be deferred by an unload
+      // listener).
+    }
+  }
+}
+
+void TabStripModel::OnNestedSubtreeOwnerDestroyed(
+    content::WebContents* contents,
+    SessionID parent_session_id) {
+  delegate_->NestedSubtreeClosed(parent_session_id);
+  nested_subtree_owner_observers_.erase(contents);
+}
+
+std::optional<int> TabStripModel::GetParentIndex(int child_idx) const {
+  tabs::TabInterface* tab = GetTabAtIndex(child_idx);
+  CHECK(tab);
+
+  // Find the first enclosing NESTED whose owner is NOT `tab` itself
+  // (an owner's immediate parent IS its own NESTED, which isn't its parent
+  // conceptually).
+  for (const tabs::TabCollection* p = tab->GetParentCollection(); p;
+       p = p->GetParentCollection()) {
+    if (p->type() == tabs::TabCollection::Type::TABSTRIP) {
+      return std::nullopt;
+    }
+    if (p->type() != tabs::TabCollection::Type::NESTED) {
+      continue;
+    }
+    tabs::TabInterface* owner = static_cast<const tabs::NestedTabCollection*>(p)
+                                    ->data()
+                                    ->owner_tab()
+                                    .Get();
+    if (owner != tab) {
+      return GetIndexOfTab(owner);
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<int> TabStripModel::GetChildIndices(int parent_idx) const {
+  tabs::TabInterface* tab = GetTabAtIndex(parent_idx);
+  CHECK(tab);
+
+  std::vector<int> children;
+  if (tabs::NestedTabCollection* nested =
+          contents_data_->GetNestedTabCollection(tab)) {
+    // Skip children[0] (the owner itself) and only return non-owner members.
+    const auto& all_children = nested->GetChildren();
+    for (size_t i = 1; i < all_children.size(); ++i) {
+      const auto& child = all_children[i];
+      if (const auto& child_coll =
+              std::get_if<std::unique_ptr<tabs::TabCollection>>(&child)) {
+        tabs::TabCollection* coll = child_coll->get();
+        if (coll->type() == tabs::TabCollection::Type::SPLIT) {
+          for (const auto& split_child : coll->GetChildren()) {
+            if (auto scti = std::get_if<tabs::ScopedTab>(
+                    &split_child)) {
+              children.push_back(GetIndexOfTab(scti->get()));
+            }
+          }
+        } else if (coll->type() == tabs::TabCollection::Type::NESTED) {
+          // Sub-NESTED's owner is conceptually a direct child of `parent`.
+          // Return the owner's index, not the bare collection.
+          tabs::TabInterface* owner =
+              static_cast<tabs::NestedTabCollection*>(coll)
+                  ->data()
+                  ->owner_tab()
+                  .Get();
+          children.push_back(GetIndexOfTab(owner));
+        }
+      } else {
+        children.push_back(GetIndexOfTab(
+            std::get<tabs::ScopedTab>(child).get()));
+      }
+    }
+  } else {
+    return {};
+  }
+
+  return children;
+}
+
+bool TabStripModel::IsDescendantOfAny(int subject,
+                                      const std::set<int>& maybe_ancestor_idxs,
+                                      bool self_is_ancestor) const {
+  tabs::TabInterface* subject_tab = GetTabAtIndex(subject);
+  std::set<tabs::TabInterface*> ancestor_tabs =
+      maybe_ancestor_idxs | std::views::transform([&](auto idx) {
+        return this->GetTabAtIndex(idx);
+      }) |
+      std::views::filter([](auto tab) { return tab; }) |
+      std::ranges::to<std::set>();
+
+  if (!subject_tab || ancestor_tabs.empty()) {
+    return false;
+  }
+
+  if (ancestor_tabs.contains(subject_tab) && self_is_ancestor) {
+    return true;
+  }
+
+  for (const tabs::TabCollection* c = subject_tab->GetParentCollection(); c;
+       c = c->GetParentCollection()) {
+    if (c->type() != tabs::TabCollection::Type::NESTED) {
+      continue;
+    }
+    const auto* nested = static_cast<const tabs::NestedTabCollection*>(c);
+    tabs::TabInterface* nested_owner = nested->data()->owner_tab().Get();
+    // Subject's own NESTED isn't an ancestor that "owns" it.
+    if (nested_owner == subject_tab) {
+      continue;
+    }
+    if (ancestor_tabs.contains(nested_owner)) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+bool TabStripModel::IsSubtreeCollapsed(
+    nested_tabs::NestedTabId nested_id) const {
+  // View-layer callers can query during transient states (e.g., the NESTED
+  // is mid-attach to a destination tabstrip during a cross-window drag).
+  // Default to not-collapsed when the NESTED isn't visible to this model.
+  tabs::NestedTabCollection* ntc =
+      contents_data_->GetNestedTabCollection(nested_id);
+  return ntc && ntc->IsCollapsed();
+}
+
+void TabStripModel::SetSubtreeCollapsed(nested_tabs::NestedTabId nested_id,
+                                        bool is_collapsed) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  SetSubtreeCollapsedImpl(nested_id, is_collapsed);
+  CompleteModelUpdateTransaction();
+}
+
+void TabStripModel::SetSubtreeCollapsedImpl(nested_tabs::NestedTabId nested_id,
+                                            bool is_collapsed) {
+  tabs::NestedTabCollection* ntc =
+      contents_data_->GetNestedTabCollection(nested_id);
+  CHECK(ntc);
+
+  bool should_notify = ntc->IsCollapsed() != is_collapsed;
+
+  if (should_notify) {
+    nested_tabs::NestedTabVisualData old = *ntc->data()->visual_data();
+    ntc->SetIsCollapsed(is_collapsed);
+    observers_.Notify(&TabStripModelObserver::OnNestedTabChanged,
+                      NestedTabChange(this, nested_id,
+                                      NestedTabChange::VisualsChange(
+                                          old, *ntc->data()->visual_data())));
+  }
+}
+
+std::set<nested_tabs::NestedTabId> TabStripModel::ListNesteds() const {
+  return contents_data_->ListNesteds();
+}
+
+const nested_tabs::NestedTabData* TabStripModel::GetNestingData(
+    nested_tabs::NestedTabId nested_id) const {
+  tabs::NestedTabCollection* ntc =
+      contents_data_->GetNestedTabCollection(nested_id);
+
+  return ntc ? ntc->data() : nullptr;
+}
+
+std::optional<nested_tabs::NestedTabId> TabStripModel::GetEnclosingNestedId(
+    int index) const {
+  tabs::TabInterface* tab = GetTabAtIndex(index);
+  if (!tab) {
+    return {};
+  }
+
+  // Deepest NESTED containing `tab` as a non-owner child. Self-owning
+  // NESTEDs are skipped, see GetInnermostNestedId for the inclusive walk.
+  for (const tabs::TabCollection* c = tab->GetParentCollection(); c;
+       c = c->GetParentCollection()) {
+    if (c->type() != tabs::TabCollection::Type::NESTED) {
+      continue;
+    }
+    const auto* nested = static_cast<const tabs::NestedTabCollection*>(c);
+    if (nested->data()->owner_tab().Get() == tab) {
+      continue;
+    }
+    return nested->GetNestedTabId();
+  }
+  return {};
+}
+
+std::optional<nested_tabs::NestedTabId> TabStripModel::GetInnermostNestedId(
+    int index) const {
+  tabs::TabInterface* tab = GetTabAtIndex(index);
+  if (!tab) {
+    return {};
+  }
+
+  for (const tabs::TabCollection* c = tab->GetParentCollection(); c;
+       c = c->GetParentCollection()) {
+    if (c->type() == tabs::TabCollection::Type::NESTED) {
+      return static_cast<const tabs::NestedTabCollection*>(c)->GetNestedTabId();
+    }
+  }
+  return {};
+}
+
+std::optional<nested_tabs::NestedTabId> TabStripModel::GetOwnedNestedId(
+    const tabs::TabInterface* tab) const {
+  tabs::NestedTabCollection* maybe_ntc =
+      contents_data_->GetNestedTabCollection(tab);
+  if (maybe_ntc) {
+    return maybe_ntc->GetNestedTabId();
+  }
+  return std::nullopt;
+}
+
+bool TabStripModel::AllCanNestInto(const std::set<int>& subject_idxs,
+                                   int target_idx) const {
+  if (subject_idxs.empty()) {
+    return false;
+  }
+  tabs::TabInterface* target_tab = GetTabAtIndex(target_idx);
+  if (!target_tab || target_tab->IsPinned() || target_tab->IsSplit()) {
+    return false;
+  }
+  if (std::ranges::any_of(subject_idxs, [&](auto subject_idx) {
+        tabs::TabInterface* subject_tab = GetTabAtIndex(subject_idx);
+        if (!subject_tab) {
+          // Invalid tab -> bail
+          return true;
+        }
+        return subject_tab->IsPinned();
+      })) {
+    return false;
+  }
+  if (IsDescendantOfAny(target_idx, subject_idxs)) {
+    return false;
+  }
+
+  return true;
+}
+
+void TabStripModel::MoveNestedTo(
+    const nested_tabs::NestedTabId& nested_id,
+    int to_index,
+    std::optional<tab_groups::TabGroupId> target_group) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  MoveNestedToImpl(nested_id, to_index, target_group);
+}
+
+void TabStripModel::MoveNestedToImpl(
+    const nested_tabs::NestedTabId& nested_id,
+    int to_index,
+    std::optional<tab_groups::TabGroupId> target_group) {
+  auto* ntc = contents_data_->GetNestedTabCollection(nested_id);
+  CHECK(ntc);
+  const int old_index = GetIndexOfTab(ntc->data()->owner_tab().Get());
+  const int sz_moving = static_cast<int>(ntc->TabCountRecursive());
+  if (to_index < 0 || to_index > count() - sz_moving) {
+    return;
+  }
+  // Compatibility path for keyboard moves and existing callers: an unchanged
+  // index and group preserves the existing parent, including at branch ends.
+  // A group transition at the same index is still a real move.
+  if (to_index == old_index &&
+      target_group == GetTabGroupForTab(old_index)) {
+    return;
+  }
+
+  // Resolve the surviving tab immediately to the right of the gap. An owner's
+  // slot means before its whole subtree, not inside that subtree. At the end
+  // there is no right-hand anchor and the destination is the group/root end.
+  const int to_index_pre =
+      to_index < old_index ? to_index : to_index + sz_moving;
+  std::optional<nested_tabs::NestedTabId> enclosing;
+  if (to_index_pre < count() &&
+      GetTabGroupForTab(to_index_pre) == target_group) {
+    enclosing = GetEnclosingNestedId(to_index_pre);
+  }
+  MoveNestedToImpl(nested_id, to_index, target_group, enclosing);
+}
+
+void TabStripModel::MoveNestedTo(
+    const nested_tabs::NestedTabId& nested_id,
+    int to_index,
+    std::optional<tab_groups::TabGroupId> target_group,
+    std::optional<nested_tabs::NestedTabId> target_parent) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  MoveNestedToImpl(nested_id, to_index, target_group, target_parent);
+}
+
+void TabStripModel::MoveNestedToImpl(
+    const nested_tabs::NestedTabId& nested_id,
+    int to_index,
+    std::optional<tab_groups::TabGroupId> target_group,
+    std::optional<nested_tabs::NestedTabId> enclosing) {
+  auto* ntc = contents_data_->GetNestedTabCollection(nested_id);
+  CHECK(ntc);
+  const int old_index = GetIndexOfTab(ntc->data()->owner_tab().Get());
+  std::vector<int> tab_indices = ntc->GetTabsRecursive() |
+                                 std::views::transform([&](const auto& tab) {
+                                   return GetIndexOfTab(tab);
+                                 }) |
+                                 std::ranges::to<std::vector<int>>();
+  const int sz_moving = static_cast<int>(tab_indices.size());
+
+  // The destination is a gap in the remaining tree, not an index into the
+  // original moving subtree. Reject invalid requests instead of relocating
+  // them to a different gap.
+  if (to_index < 0 || to_index > count() - sz_moving) {
+    return;
+  }
+  if (target_group && !contents_data_->GetTabGroupCollection(*target_group)) {
+    return;
+  }
+
+  tabs::TabCollection* destination = contents_data_->unpinned_collection();
+  if (enclosing) {
