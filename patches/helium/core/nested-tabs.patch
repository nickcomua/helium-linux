+namespace {
+
+// Recursively applies the nesting encoded in |entry| onto live tabs starting
+// at live_ids[live_idx]. Advances |live_idx| past this entry's subtree
+// (1 + recursive descendant count). Each non-empty children vector triggers
+// Nest calls (idempotent, if already nested, the move is a no-op).
+void NestEntrySubtree(const sessions::tab_restore::Tab& entry,
+                      const std::vector<SessionID>& live_ids,
+                      size_t& live_idx,
+                      TabStripModel& tab_strip_model) {
+  if (live_idx >= live_ids.size()) {
+    return;
+  }
+  SessionID this_id = live_ids[live_idx++];
+  tabs::TabInterface* this_tab = FindTabWithSessionID(tab_strip_model, this_id);
+
+  for (const auto& child_entry : entry.children) {
+    if (live_idx >= live_ids.size()) {
+      return;
+    }
+    SessionID child_id = live_ids[live_idx];
+    // Recurse first so grandchildren are nested under this child before
+    // the child itself is nested under |this_tab|.
+    NestEntrySubtree(*child_entry, live_ids, live_idx, tab_strip_model);
+
+    if (!this_tab) {
+      continue;
+    }
+    tabs::TabInterface* child_tab = FindTabWithSessionID(tab_strip_model, child_id);
+    if (!child_tab) {
+      continue;
+    }
+    if (this_tab->IsPinned() || this_tab->IsSplit()) {
+      continue;  // can't NEST under a pinned/split tab
+    }
+    const int parent_idx = tab_strip_model.GetIndexOfTab(this_tab);
+    const int child_strip_idx = tab_strip_model.GetIndexOfTab(child_tab);
+    if (parent_idx < 0 || child_strip_idx < 0) {
+      continue;
+    }
+    tab_strip_model.Nest(parent_idx, {child_strip_idx}, std::nullopt,
+                         std::nullopt);
+  }
+}
+
+}  // namespace
+
+void BrowserLiveTabContext::NestTabsByStructure(
+    const std::vector<SessionID>& live_tab_ids,
+    const std::vector<std::unique_ptr<sessions::tab_restore::Tab>>& entries) {
+  size_t live_idx = 0;
+  for (const auto& entry : entries) {
+    if (live_idx >= live_tab_ids.size()) {
+      return;
+    }
+    NestEntrySubtree(*entry, live_tab_ids, live_idx, *tab_strip_model_);
+  }
+}
+
+std::optional<nested_tabs::NestedTabVisualData>
+BrowserLiveTabContext::GetNestedVisualData(int index) const {
+  for (const auto id : tab_strip_model_->ListNesteds()) {
+    const auto* data = tab_strip_model_->GetNestingData(id);
+    if (data->owner_tab().Get() == tab_strip_model_->GetTabAtIndex(index)) {
+      return *data->visual_data();
+    }
+  }
+  return std::nullopt;
+}
+
+void BrowserLiveTabContext::SetNestedVisualData(
+    SessionID owner, const nested_tabs::NestedTabVisualData& data) {
+  auto* tab = FindTabWithSessionID(*tab_strip_model_, owner);
+  if (!tab) {
+    return;
+  }
+  for (const auto id : tab_strip_model_->ListNesteds()) {
+    if (tab_strip_model_->GetNestingData(id)->owner_tab().Get() == tab) {
+      tab_strip_model_->SetSubtreeCollapsed(id, data.IsCollapsed());
+      return;
+    }
+  }
+}
+
+void BrowserLiveTabContext::NestRestoredTab(
+    SessionID owner, SessionID child, size_t child_index) {
+  auto* parent = FindTabWithSessionID(*tab_strip_model_, owner);
+  auto* tab = FindTabWithSessionID(*tab_strip_model_, child);
+  if (!parent || !tab || parent == tab || parent->IsPinned() ||
+      parent->IsSplit() || tab->IsPinned() || tab->IsSplit() ||
+      parent->GetGroup() != tab->GetGroup()) {
+    return;
+  }
+  if (tab_strip_model_->IsDescendantOfAny(
+          tab_strip_model_->GetIndexOfTab(parent),
+          {tab_strip_model_->GetIndexOfTab(tab)})) {
+    return;
+  }
+  tab_strip_model_->Nest(tab_strip_model_->GetIndexOfTab(parent),
+                         {tab_strip_model_->GetIndexOfTab(tab)},
+                         std::nullopt,
+                         std::min(child_index, tab_strip_model_->GetChildIndices(
+                             tab_strip_model_->GetIndexOfTab(parent)).size()));
+}
