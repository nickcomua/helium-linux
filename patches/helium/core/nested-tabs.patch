+  // Prefer the first surviving successor, then the last surviving predecessor.
+  // Search the full original order, not merely the immediately adjacent tab:
+  // A,B,E(F) -> E(F),A,B -> close B -> Escape must yield A,E(F).
+  for (auto it = std::next(original_owner); it != original_order.end(); ++it) {
+    auto anchor = std::ranges::find(anchors, *it, &AnchorGap::tab);
