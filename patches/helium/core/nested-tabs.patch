+void TabStripModel::RevertNestedOwnerDrag(
+    tabs::TabHandle owner_handle,
+    std::vector<tabs::TabHandle> original_order,
+    std::optional<tab_groups::TabGroupId> original_group,
+    std::vector<NestedDragRestoreData> state) {
+  // Both snapshots are owned by this stack frame: notifications may destroy
+  // the drag controller which supplied them. Each public operation owns its
+  // transaction. Do not flatten the owner out of its moving closure.
+  const auto original_owner = std::ranges::find(original_order, owner_handle);
+  if (original_owner == original_order.end()) {
+    return;
+  }
+  auto ref = weak_factory_.GetWeakPtr();
+  RestoreNestedDragState(state);
+  if (!ref) {
+    return;
+  }
+  auto* owner = owner_handle.Get();
+  if (!owner || GetIndexOfTab(owner) == kNoTab || owner->IsPinned()) {
+    return;
+  }
+
+  // Re-resolve identities after every notifying stage. A parent's wrapper may
+  // have disappeared and been recreated; a missing parent means root/group.
+  auto resolve_parent = [&]() -> std::optional<nested_tabs::NestedTabId> {
+    for (const auto& entry : state) {
+      if (std::ranges::contains(entry.children, owner_handle)) {
+        auto* parent = entry.owner.Get();
+        if (parent && GetIndexOfTab(parent) != kNoTab) {
+          return GetOwnedNestedId(parent);
+        }
+        break;
+      }
+    }
+    return std::nullopt;
+  };
+  auto parent = resolve_parent();
+  // A surviving direct parent is authoritative for group membership.
+  if (parent) {
+    original_group = GetNestingData(*parent)->owner_tab().Get()->GetGroup();
+  }
+  const bool recreate_group =
+      original_group && !group_model()->GetTabGroup(*original_group);
+  if (recreate_group) {
+    std::vector<int> members{GetIndexOfTab(owner)};
+    if (auto nested = GetOwnedNestedId(owner)) {
+      members.clear();
+      for (auto* tab : GetNestingData(*nested)->ListTabs()) {
+        members.push_back(GetIndexOfTab(tab));
+      }
+    }
+    AddToGroupForRestore(members, *original_group);
+    if (!ref) {
+      return;
+    }
+    owner = owner_handle.Get();
+    if (!owner || GetIndexOfTab(owner) == kNoTab) {
+      return;
+    }
+    parent = resolve_parent();
+  }
+
+  auto nested = GetOwnedNestedId(owner);
+  std::vector<int> moving{GetIndexOfTab(owner)};
+  if (nested) {
+    moving.clear();
+    for (auto* tab : GetNestingData(*nested)->ListTabs()) {
+      moving.push_back(GetIndexOfTab(tab));
+    }
+  }
+  tabs::TabCollection* destination = contents_data_->unpinned_collection();
+  if (parent) {
+    destination = contents_data_->GetNestedTabCollection(*parent);
+  } else if (original_group && !recreate_group) {
+    destination = contents_data_->GetTabGroupCollection(*original_group);
+  }
+  if (!destination) {
+    return;
+  }
+
+  // Record legal direct-child gaps in remaining-tree coordinates. Anchors
+  // inside a sibling subtree/group name its outside edge, never its interior.
+  struct AnchorGap {
+    tabs::TabHandle tab;
+    int before;
+    int after;
+  };
+  std::vector<AnchorGap> anchors;
+  const auto destination_tabs = destination->GetTabsRecursive();
+  if (destination_tabs.empty()) {
+    return;
+  }
+  const int first = GetIndexOfTab(destination_tabs.front());
+  int boundary = first - static_cast<int>(std::ranges::count_if(
+      moving, [first](int index) { return index < first; }));
+  for (const auto& child : destination->GetChildren()) {
+    std::vector<tabs::TabInterface*> tabs;
+    if (std::holds_alternative<tabs::ScopedTab>(child)) {
+      tabs.push_back(std::get<tabs::ScopedTab>(child).get());
+    } else {
+      tabs = std::get<std::unique_ptr<tabs::TabCollection>>(child)
+                 ->GetTabsRecursive();
