+#include "components/tabs/public/nested_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/gfx/range/range.h"
+
+namespace nested_tabs {
+
+// Contains metadata for a nested tab collection such as the id and split layout
+// orientation. Also provides a way to access a the list of tabs in the split.
+class NestedTabData {
+ public:
+  NestedTabData(tabs::NestedTabCollection* collection,
+                const nested_tabs::NestedTabId& id,
+                const NestedTabVisualData& visual_data,
+                tabs::TabHandle owner_tab);
+  ~NestedTabData() = default;
+
+  const nested_tabs::NestedTabId& id() const { return id_; }
+
+  NestedTabVisualData* visual_data() { return &visual_data_; }
+
+  const NestedTabVisualData* visual_data() const { return &visual_data_; }
+
+  const tabs::TabHandle& owner_tab() const { return owner_tab_; }
+
+  std::vector<tabs::TabInterface*> ListTabs() const;
+
+  // Returns the TabCollection handle associated with this nested collection.
+  tabs::TabCollection::Handle GetCollectionHandle() const;
+
+  // Returns [start, end) where the leftmost tab in the split has index start
+  // and the rightmost tab in the split has index end - 1.
+  gfx::Range GetIndexRange() const;
+
+ private:
+  raw_ptr<tabs::NestedTabCollection> collection_;
+  tabs::TabHandle owner_tab_;
+  NestedTabVisualData visual_data_;
+  nested_tabs::NestedTabId id_;
+};
+
+}  // namespace nested_tabs
+
+#endif  // COMPONENTS_TABS_PUBLIC_NESTED_TAB_DATA_H_
