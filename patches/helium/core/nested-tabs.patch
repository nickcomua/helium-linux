+std::vector<TabStripModel::NestedDragRestoreData>
+TabStripModel::CaptureNestedDragState(
+    const std::vector<tabs::TabHandle>& dragged_tabs) const {
+  std::vector<NestedDragRestoreData> state;
+  for (const auto& id : ListNesteds()) {
+    const auto* data = GetNestingData(id);
+    const auto members = data->ListTabs();
+    const bool affected = std::ranges::any_of(dragged_tabs, [&](auto handle) {
+      return handle.Get() && std::ranges::contains(members, handle.Get());
+    });
+    if (!affected) {
+      continue;
+    }
+    NestedDragRestoreData entry{id, data->owner_tab(), {}, *data->visual_data()};
+    for (int child : GetChildIndices(GetIndexOfTab(entry.owner.Get()))) {
+      entry.children.push_back(GetTabAtIndex(child)->GetHandle());
+    }
+    state.push_back(std::move(entry));
+  }
+  // Preorder tab indices give a topological order even for sibling subtrees.
+  std::ranges::sort(state, [&](const auto& a, const auto& b) {
+    return GetIndexOfTab(a.owner.Get()) > GetIndexOfTab(b.owner.Get());
+  });
+  return state;
+}
+
+void TabStripModel::PrepareNestedDragRestore(
+    std::vector<NestedDragRestoreData> state) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  for (const auto& entry : state) {
+    auto* owner = entry.owner.Get();
+    if (!owner || GetIndexOfTab(owner) == kNoTab) {
+      continue;
+    }
+    // Resolve by owner: a wrapper may have been destroyed and recreated under
+    // a new collection handle/id during the drag.
+    if (auto id = GetOwnedNestedId(owner)) {
+      UnnestImpl(*id);
+    }
+  }
+  CompleteModelUpdateTransaction();
+}
+
+void TabStripModel::RestoreNestedDragState(
+    std::vector<NestedDragRestoreData> state) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  for (const auto& entry : state) {
+    auto* owner = entry.owner.Get();
+    if (!owner || GetIndexOfTab(owner) == kNoTab || owner->IsPinned() ||
+        owner->IsSplit()) {
+      continue;
+    }
+    std::vector<int> children;
+    for (auto handle : entry.children) {
+      auto* child = handle.Get();
+      if (child && GetIndexOfTab(child) != kNoTab && !child->IsPinned()) {
+        children.push_back(GetIndexOfTab(child));
+      }
+    }
+    // Build descendants first, then attach their owner as one subtree to its
+    // original parent. NestImpl preserves the supplied direct-child order.
+    if (!children.empty()) {
+      std::ignore = NestImpl(GetIndexOfTab(owner), children, entry.visual_data,
+                            0, entry.id);
+    }
+    // FindOrCreateNestedFor leaves an existing wrapper's visuals untouched.
+    // Restore the saved value even when the drag kept that wrapper alive.
+    if (auto id = GetOwnedNestedId(owner)) {
+      auto* nested = contents_data_->GetNestedTabCollection(*id);
+      const auto old = *nested->data()->visual_data();
+      if (old != entry.visual_data) {
+        *nested->data()->visual_data() = entry.visual_data;
+        observers_.Notify(&TabStripModelObserver::OnNestedTabChanged,
+                          NestedTabChange(this, *id,
+                              NestedTabChange::VisualsChange(
+                                  old, entry.visual_data)));
+      }
+    }
+  }
+  CompleteModelUpdateTransaction();
+}
