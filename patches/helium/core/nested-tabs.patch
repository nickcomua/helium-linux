+    SessionID window_id,
+    const nested_tabs::NestedTabId& nested_id,
+    const nested_tabs::NestedTabVisualData* visual_data,
+    SessionID owner) {
+  if (!ShouldTrackChangesToWindow(window_id)) {
+    return;
+  }
+
+  // Any nested metadata changes happening in a closing window can be ignored.
+  if (pending_window_close_ids_.contains(window_id) ||
+      window_closing_ids_.contains(window_id)) {
+    return;
+  }
+
+  ScheduleCommand(sessions::CreateNestedTabDataUpdateCommand(
+      nested_id, visual_data, owner));
